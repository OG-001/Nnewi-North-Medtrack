node_modules/
dist/
dist-ssr/
*.local
.DS_Store
.env
.env.*
!.env.example
coverage/
.vite/
*.log
pnpm-debug.log*

# Playwright output (test harness arrives in Phase 0)
playwright-report/
test-results/

# Session-local agent runtime state, never committed.
# See .claude/rules/concurrent-sessions.md. Everything else under .claude/ IS
# version-controlled on purpose: the agent system travels with the repository.
.claude/session-git-locks.json
.claude/sessions/
# Machine-local permission grants. These authorise commands on one developer's
# machine, so they are not a project decision and must not travel in the repo.
.claude/settings.local.json

# Local demo credentials — never committed (governance: no secrets in the repo).
credentials.md
apps/api/dist/
packages/shared/dist/

# Evidence archives. The screenshots and video under docs/evidence/ are tracked
# individually; these .zip bundles only repackage them, so committing one stores
# the same pixels a second time in a form git cannot diff or deduplicate.
# Build them when you need to hand the evidence over, do not commit them.
docs/evidence/*.zip
docs/evidence/**/*.zip
