# PHC-Track sync hub, local development. Copy to apps/api/.env and fill in.
# Never commit the filled-in file. Production values live in infra/.env.
#
# A template carries placeholders only, never a working credential, even a
# development one: a real-looking value in a tracked file is how a credential
# eventually reaches production by copy and paste.

DATABASE_URL="postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5432/phc_track?schema=public"

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET="CHANGE_ME"

ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"
PORT=3000
CORS_ORIGINS="http://localhost:5173,http://localhost:4173"

# SMS is off by default; see infra/.env.example for the provider keys.
SMS_REMINDERS_ENABLED=false
