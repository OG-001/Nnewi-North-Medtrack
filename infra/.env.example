# PHC-Track environment template.
#
# Copy to infra/.env and fill in. NEVER commit the filled-in file: .env is
# gitignored, and the safety gate blocks edits to it.
#
# Locked decision: patient data stays in Nigeria (NDPA 2023). Host this stack
# in-country, and keep backups in-country too.
#
# Generate every secret below with a CSPRNG, for example:
#   openssl rand -base64 48

# ---- Site ----
# The public hostname. Caddy obtains and renews a TLS certificate for it.
PHC_DOMAIN=phc.example.ng
# Address Let's Encrypt uses for expiry notices. A real, monitored mailbox.
PHC_ACME_EMAIL=it@example.ng

# ---- Database ----
POSTGRES_USER=phc
POSTGRES_DB=phc_track
# REQUIRED. No default anywhere; the stack refuses to start without it.
POSTGRES_PASSWORD=

# ---- API / sync hub ----
# REQUIRED. Signs access tokens. At least 32 characters of real entropy.
# Rotating it invalidates every access token, which forces a re-login. That is
# the correct response to a suspected compromise.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Same-origin in production, so CORS is unused. Set only if you split origins,
# and never to "*".
# CORS_ORIGINS=https://phc.example.ng

# Rate limiting. The default suits a facility with a handful of devices. A busy
# PHC syncing many devices may need more headroom; the automated test suite
# needs far more (see RUNNING.md).
# RATE_LIMIT_PER_WINDOW=120
# RATE_LIMIT_WINDOW_MS=60000

# ---- Backups ----
# REQUIRED. Encrypts every backup. Store it in the secret manager, NOT beside
# the backups: an encrypted backup whose passphrase sits next to it is not
# encrypted in any way that matters. Losing it means losing every backup.
BACKUP_PASSPHRASE=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# ---- SMS (Phase 7, provider-agnostic) ----
# Leave SMS_REMINDERS_ENABLED=false until the templates have been reviewed by an
# Igbo speaker and a data processing agreement is signed with the provider.
SMS_REMINDERS_ENABLED=false
SMS_PROVIDER=africastalking
SMS_SENDER_ID=PHCTrack
SMS_REMINDER_LEAD_DAYS=2
SMS_REMINDER_SCAN_MINUTES=60
# Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_WEBHOOK_SECRET=
# Termii
TERMII_API_KEY=
TERMII_WEBHOOK_SECRET=

# ---- Reporting ----
# DHIS2 data-element mapping, as JSON: our figure keys to DHIS2 UIDs, plus
# "orgUnit:<facilityCode>" entries. Until this is set, the export names every
# unmapped element rather than pretending our keys are DHIS2 identifiers.
# Open question Q4.
# DHIS2_ELEMENT_MAP={"new_patients":"UID","orgUnit:NNW0062":"OU_UID"}

# ---- Development only ----
# The dev stack in infra/docker-compose.yml uses phc / phc_dev_only. Those are
# development credentials and must never appear in a deployment.
