# NestJS sync hub (apps/api), running as an unprivileged user.
# Build context is the repo root:  docker build -f infra/Dockerfile.api .

FROM node:20-alpine AS build
WORKDIR /repo
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile --filter @phc/api... --filter @phc/shared...

COPY packages/shared packages/shared
COPY apps/api apps/api
RUN pnpm --filter @phc/shared build \
 && pnpm --filter @phc/api exec prisma generate \
 && pnpm --filter @phc/api build

FROM node:20-alpine AS runtime
WORKDIR /repo
RUN corepack enable
ENV NODE_ENV=production

COPY --from=build /repo/node_modules node_modules
COPY --from=build /repo/packages/shared packages/shared
COPY --from=build /repo/apps/api apps/api
COPY --from=build /repo/package.json /repo/pnpm-workspace.yaml ./

# `node` (uid 1000) ships with the image; never run the hub as root.
RUN chown -R node:node /repo
USER node

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/v1/system/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Migrations are applied on start so a fresh volume comes up ready. This is
# `migrate deploy`, which only applies committed migrations and never generates
# or resets one.
CMD ["sh", "-c", "cd apps/api && npx prisma migrate deploy && node dist/src/main.js"]
