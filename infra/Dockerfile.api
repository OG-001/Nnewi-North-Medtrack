# NestJS sync hub (apps/api), running as an unprivileged user.
# Build context is the repo root:  docker build -f infra/Dockerfile.api .

FROM node:20-alpine AS build
WORKDIR /repo
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile --filter @phc/api... --filter @phc/shared...

COPY packages/shared packages/shared
COPY apps/api apps/api
RUN pnpm --filter @phc/shared build \
 && pnpm --filter @phc/api exec prisma generate \
 && pnpm --filter @phc/api build

FROM node:20-alpine AS runtime
WORKDIR /repo
RUN corepack enable
ENV NODE_ENV=production

COPY --from=build /repo/node_modules node_modules
COPY --from=build /repo/packages/shared packages/shared
COPY --from=build /repo/apps/api apps/api
COPY --from=build /repo/package.json /repo/pnpm-workspace.yaml ./

# `node` (uid 1000) ships with the image; never run the hub as root.
RUN chown -R node:node /repo
USER node

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/v1/system/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Migrations are NOT applied on start by default.
#
# They used to be, so a fresh volume came up ready. That is safe for exactly one
# always-on container and unsafe everywhere else:
#
#   - Several instances starting together race each other on the same database.
#     Prisma takes an advisory lock, so one wins and the rest block, turning a
#     cold start into a timeout.
#   - On a platform whose instances wake on demand, this runs on every wake, so
#     the cost is paid forever rather than once.
#   - It needs a session-level connection. A hub pointed at a pooled endpoint
#     cannot migrate through it at all.
#
# Apply migrations as a deliberate deployment step instead, from CI or an
# operator machine, against DIRECT_DATABASE_URL:
#
#   pnpm db:deploy
#
# Set RUN_MIGRATIONS_ON_START=true to restore the old behaviour. It is there for
# a single-container local stack, where the race cannot happen. Never set it on
# a multi-instance deployment.
CMD ["sh", "-c", "cd apps/api &&   if [ "$RUN_MIGRATIONS_ON_START" = "true" ]; then npx prisma migrate deploy; fi &&   node dist/src/main.js"]
