{
  "name": "phc-track",
  "private": true,
  "version": "0.1.0",
  "description": "Nnewi North PHC Digital Health Platform (codename PHC-Track) \u2014 offline-first PWA",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @phc/web dev",
    "dev:api": "pnpm --filter @phc/api dev",
    "build": "pnpm --filter @phc/shared build && pnpm --filter @phc/web build",
    "build:api": "pnpm --filter @phc/shared build && pnpm --filter @phc/api build",
    "preview": "pnpm --filter @phc/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @phc/web lint",
    "test": "pnpm -r --filter @phc/api --filter @phc/web test",
    "db:migrate": "pnpm --filter @phc/api prisma:migrate",
    "db:seed": "pnpm --filter @phc/api seed",
    "e2e": "pnpm --filter @phc/web e2e",
    "test:all": "pnpm test && pnpm e2e"
  }
}